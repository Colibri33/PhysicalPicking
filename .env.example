# ============================================================
# PhysicalPicking Backend - variables de entorno
# Copia este archivo a ".env" y completa los valores.
# ".env" esta en .gitignore: NUNCA subir claves reales a Git.
# ============================================================

# Supabase (obligatorio)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Puerto del backend (opcional, default 8080)
PORT=8080

# Origen(es) permitidos para CORS, separados por coma (opcional; si esta vacio no se permite ninguno)
CORS_ORIGIN=http://localhost:3000

# Clave de cifrado de datos sensibles con AES-256-GCM (OBLIGATORIA en runtime)
# Debe ser una cadena hexadecimal de 64 caracteres (32 bytes). Generar una clave nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardar el valor SOLO en el entorno/backend (.env local o variable de entorno del deploy).
FIELD_ENCRYPTION_KEY=
