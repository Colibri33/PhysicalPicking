# ── Supabase ──
# Panel Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY   # ¡SECRETA! nunca va al frontend

# ── Cifrado de campos sensibles (AES-256-GCM) ──
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=REEMPLAZA_CON_64_HEX_CHARS

# ── CORS ──
# Dominios permitidos a consumir esta API (tu web en Render/Vercel/Netlify)
CORS_ORIGIN=https://tu-app-web.onrender.com,http://localhost:5173

# ── Servidor ──
PORT=8080

# Versión vigente de la política de tratamiento de datos.
# Súbela cada vez que cambie el documento legal; se guarda junto
# con cada consentimiento como evidencia de qué versión aceptó el usuario.
POLITICA_VERSION=v1.0-2026-08
